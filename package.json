{
  "name": "brain-content-registry",
  "version": "0.1.0",
  "private": true,
  "description": "Brain Registry: immutable static research-agent content with generic HTTP and MCP-resource delivery.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "brain-content-registry": "./dist/src/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "content-src",
    "dist",
    "scripts"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run clean && npm run build && node --test dist/test/*.test.js",
    "manifest": "node scripts/generate-manifest.mjs",
    "publish-bundle": "node scripts/publish-bundle.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0"
  }
}
